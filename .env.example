# Copy to .env and fill in. Never commit the real .env file.

MOFID_BASE_URL=https://m.easytrader.ir
MOFID_USERNAME=
MOFID_PASSWORD=

# Keep this true until bot/broker/mofid_playwright.py's order-screen
# selectors are verified against a real test order.
DRY_RUN=true

# false = open a visible browser window (only works with a display, or
# HEADLESS=false is really for local testing). true = no UI, for VPS/systemd.
HEADLESS=true

# Where the logged-in browser session (cookies etc.) is cached so the bot
# doesn't have to redo the OAuth login on every order. Delete this file to
# force a fresh login (e.g. after changing your password).
STORAGE_STATE_PATH=auth_state.json

# Debug screenshots are saved per order under logs/screenshots/<run>/ and
# folders older than this are deleted automatically.
SCREENSHOT_RETENTION_DAYS=3

# How many seconds past the scheduled time we still allow an order to fire
# (covers bot restarts / brief downtime). Past this, the order is skipped.
GRACE_PERIOD_SECONDS=120

MAX_RETRIES=5
RETRY_DELAY_SECONDS=2

# --- panel/main.py (web panel) only ---
# Required. This is the password you'll type on the panel's login page.
PANEL_PASSWORD=
# Optional. Random each restart if unset (existing sessions get logged out
# on restart). Set a fixed value to keep sessions across restarts.
SESSION_SECRET=
PANEL_DB_PATH=panel.db
