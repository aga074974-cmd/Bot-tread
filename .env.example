# Copy to .env and fill in. Never commit the real .env file.

MOFID_BASE_URL=https://m.easytrader.ir
MOFID_USERNAME=
MOFID_PASSWORD=

# Keep this true until bot/broker/mofid_playwright.py's order-screen
# selectors are verified against a real test order.
DRY_RUN=true

# false = open a visible browser window (only works with a display, or
# HEADLESS=false is really for local testing). true = no UI, for VPS/systemd.
HEADLESS=true

# How many seconds past the scheduled time we still allow an order to fire
# (covers bot restarts / brief downtime). Past this, the order is skipped.
GRACE_PERIOD_SECONDS=120

MAX_RETRIES=5
RETRY_DELAY_SECONDS=2
