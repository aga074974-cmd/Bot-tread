[Unit]
Description=Mofid EasyTrader scheduled order bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mofidbot
WorkingDirectory=/opt/mofid-bot
EnvironmentFile=/opt/mofid-bot/.env
ExecStart=/opt/mofid-bot/.venv/bin/python /opt/mofid-bot/main.py --orders /opt/mofid-bot/orders.yaml
Restart=on-failure
RestartSec=10

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mofid-bot

[Install]
WantedBy=multi-user.target
